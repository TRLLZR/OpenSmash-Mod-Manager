<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:sys="clr-namespace:System;assembly=mscorlib"
 Title="OpenSmash Mod Manager" Width="1120" Height="820" MinWidth="840" MinHeight="620"
 WindowStartupLocation="CenterScreen" FontFamily="Trebuchet MS, Segoe UI" FontSize="{DynamicResource BodySize}"
 Background="{DynamicResource WindowSurface}" Foreground="{DynamicResource Text}"
 UseLayoutRounding="True" SnapsToDevicePixels="True" TextOptions.TextFormattingMode="Display">
 <Window.Resources>
  <sys:Double x:Key="BodySize">14</sys:Double><sys:Double x:Key="MetaSize">13</sys:Double><sys:Double x:Key="SectionSize">19</sys:Double><sys:Double x:Key="DetailSize">18</sys:Double><sys:Double x:Key="TitleSize">27</sys:Double>
  <!-- Geometry and typography tokens; color and motion tokens come from ModManager.ps1. -->
  <Style x:Key="AppearanceMenu" TargetType="ContextMenu">
   <Setter Property="MinWidth" Value="225"/><Setter Property="FontSize" Value="14"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ContextMenu">
    <Border Background="{TemplateBinding Background}" BorderBrush="{DynamicResource ControlBorder}" BorderThickness="1" CornerRadius="10" Padding="5"><ItemsPresenter/></Border>
   </ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style x:Key="AppearanceItem" TargetType="MenuItem">
   <Setter Property="Background" Value="Transparent"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="MenuItem">
    <Border x:Name="ItemSurface" Background="{TemplateBinding Background}" CornerRadius="6" Padding="10,8">
     <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="27"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
      <TextBlock x:Name="Mark" Text="✓" Foreground="{TemplateBinding Foreground}" Visibility="Hidden"/>
      <ContentPresenter Grid.Column="1" ContentSource="Header" RecognizesAccessKey="True" TextElement.Foreground="{TemplateBinding Foreground}"/>
     </Grid>
    </Border>
    <ControlTemplate.Triggers>
     <Trigger Property="IsChecked" Value="True"><Setter TargetName="Mark" Property="Visibility" Value="Visible"/></Trigger>
     <Trigger Property="IsHighlighted" Value="True"><Setter TargetName="ItemSurface" Property="Background" Value="{DynamicResource SelectedSurface}"/></Trigger>
    </ControlTemplate.Triggers>
   </ControlTemplate></Setter.Value></Setter>
  </Style>
  <CornerRadius x:Key="PanelRadius">24</CornerRadius><CornerRadius x:Key="ControlRadius">14</CornerRadius>
  <CornerRadius x:Key="InputRadius">11</CornerRadius><Thickness x:Key="PanelPadding">18,16</Thickness>
  <Thickness x:Key="ButtonPadding">16,10</Thickness><Thickness x:Key="PageMargin">26,22</Thickness>
  <CubicEase x:Key="EaseOut" EasingMode="EaseOut"/>
  <LinearGradientBrush x:Key="Specular" StartPoint="0,0" EndPoint="0,1">
   <GradientStop Color="#BAFFFFFF"/><GradientStop Color="#18FFFFFF" Offset="0.72"/><GradientStop Color="#00FFFFFF" Offset="1"/>
  </LinearGradientBrush>
  <Style x:Key="FocusRing" TargetType="Control">
   <Setter Property="Template"><Setter.Value><ControlTemplate>
    <Border BorderBrush="{DynamicResource ControlBorder}" BorderThickness="2" CornerRadius="10" Margin="-3"/>
   </ControlTemplate></Setter.Value></Setter>
  </Style>
  <!-- The stock WPF determinate bar keeps a glow animation running even at 100%.
       Batch progress is an honest item count and has no idle animation clock. -->
  <Style x:Key="ItemProgress" TargetType="ProgressBar">
   <Setter Property="Foreground" Value="{DynamicResource Accent}"/>
   <Setter Property="Background" Value="{DynamicResource SoftSurface}"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ProgressBar">
    <Grid ClipToBounds="True"><Border x:Name="PART_Track" Background="{TemplateBinding Background}" CornerRadius="5"/>
     <Border x:Name="PART_Indicator" Background="{TemplateBinding Foreground}" HorizontalAlignment="Left" CornerRadius="5"/>
    </Grid>
   </ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style TargetType="Button">
   <Setter Property="Foreground" Value="{DynamicResource Text}"/>
   <Setter Property="Background" Value="{DynamicResource ButtonSurface}"/>
   <Setter Property="BorderBrush" Value="{DynamicResource ControlBorder}"/>
   <Setter Property="BorderThickness" Value="1"/><Setter Property="Padding" Value="{StaticResource ButtonPadding}"/>
   <Setter Property="HorizontalContentAlignment" Value="Center"/><Setter Property="MinHeight" Value="42"/><Setter Property="FontSize" Value="{DynamicResource BodySize}"/>
   <Setter Property="FontWeight" Value="SemiBold"/><Setter Property="Cursor" Value="Hand"/>
   <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRing}"/>
   <Setter Property="Template"><Setter.Value>
    <ControlTemplate TargetType="Button">
     <Grid x:Name="ButtonFace" RenderTransformOrigin="0.5,0.5" Margin="0,0,0,3">
      <Grid.RenderTransform><TransformGroup><ScaleTransform/><TranslateTransform/></TransformGroup></Grid.RenderTransform>
      <Border x:Name="ButtonPlinth" Background="{DynamicResource ButtonDepth}" CornerRadius="{StaticResource ControlRadius}" Margin="0,3,0,-3" Opacity="{DynamicResource ReflectionOpacity}" IsHitTestVisible="False"/>
      <Border x:Name="ButtonSkin" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="{StaticResource ControlRadius}">
      <Grid>
       <Border Background="{DynamicResource ButtonBevel}" CornerRadius="13" Margin="1" Opacity="{DynamicResource ReflectionOpacity}" IsHitTestVisible="False"/>
       <Border x:Name="ButtonShine" Background="{StaticResource Specular}" CornerRadius="13" Height="12" VerticalAlignment="Top" Margin="1" Opacity="{DynamicResource ReflectionOpacity}" IsHitTestVisible="False"><Border.RenderTransform><TranslateTransform/></Border.RenderTransform></Border>
       <Border BorderBrush="#99FFFFFF" BorderThickness="1,1,1,0" CornerRadius="12" Margin="1" Opacity="{DynamicResource ReflectionOpacity}" IsHitTestVisible="False"/>
       <Border BorderBrush="#40608A8C" BorderThickness="0,0,0,1" CornerRadius="12" Margin="2" Opacity="{DynamicResource ReflectionOpacity}" IsHitTestVisible="False"/>
       <Border x:Name="HoverLight" Background="{DynamicResource HoverTint}" Opacity="0" CornerRadius="10" IsHitTestVisible="False"/>
       <ContentPresenter Margin="{TemplateBinding Padding}" HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="Center" RecognizesAccessKey="True"/>
      </Grid>
      </Border>
     </Grid>
     <ControlTemplate.Triggers>
      <Trigger Property="IsMouseOver" Value="True">
       <Trigger.EnterActions><BeginStoryboard><Storyboard>
        <DoubleAnimation Storyboard.TargetName="HoverLight" Storyboard.TargetProperty="Opacity" To="0.16" Duration="__HOVER__"/>
        <DoubleAnimation Storyboard.TargetName="ButtonShine" Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.Y)" From="-2" To="3" Duration="__HOVER__"/>
        <DoubleAnimation Storyboard.TargetName="ButtonFace" Storyboard.TargetProperty="(UIElement.RenderTransform).(TransformGroup.Children)[1].(TranslateTransform.Y)" To="__LIFT__" Duration="__HOVER__" EasingFunction="{StaticResource EaseOut}"/>
       </Storyboard></BeginStoryboard></Trigger.EnterActions>
       <Trigger.ExitActions><BeginStoryboard><Storyboard>
        <DoubleAnimation Storyboard.TargetName="HoverLight" Storyboard.TargetProperty="Opacity" To="0" Duration="__HOVER__"/>
        <DoubleAnimation Storyboard.TargetName="ButtonFace" Storyboard.TargetProperty="(UIElement.RenderTransform).(TransformGroup.Children)[1].(TranslateTransform.Y)" To="0" Duration="__HOVER__"/>
       </Storyboard></BeginStoryboard></Trigger.ExitActions>
      </Trigger>
      <Trigger Property="IsPressed" Value="True">
       <Setter TargetName="ButtonPlinth" Property="Opacity" Value="0.25"/>
       <Trigger.EnterActions><BeginStoryboard><Storyboard>
        <DoubleAnimation Storyboard.TargetName="ButtonFace" Storyboard.TargetProperty="(UIElement.RenderTransform).(TransformGroup.Children)[0].(ScaleTransform.ScaleX)" To="0.98" Duration="__PRESS__"/>
        <DoubleAnimation Storyboard.TargetName="ButtonFace" Storyboard.TargetProperty="(UIElement.RenderTransform).(TransformGroup.Children)[0].(ScaleTransform.ScaleY)" To="0.98" Duration="__PRESS__"/>
        <DoubleAnimation Storyboard.TargetName="ButtonFace" Storyboard.TargetProperty="(UIElement.RenderTransform).(TransformGroup.Children)[1].(TranslateTransform.Y)" To="2" Duration="__PRESS__"/>
       </Storyboard></BeginStoryboard></Trigger.EnterActions>
       <Trigger.ExitActions><BeginStoryboard><Storyboard>
        <DoubleAnimation Storyboard.TargetName="ButtonFace" Storyboard.TargetProperty="(UIElement.RenderTransform).(TransformGroup.Children)[0].(ScaleTransform.ScaleX)" To="1" Duration="__PRESS__"/>
        <DoubleAnimation Storyboard.TargetName="ButtonFace" Storyboard.TargetProperty="(UIElement.RenderTransform).(TransformGroup.Children)[0].(ScaleTransform.ScaleY)" To="1" Duration="__PRESS__"/>
        <DoubleAnimation Storyboard.TargetName="ButtonFace" Storyboard.TargetProperty="(UIElement.RenderTransform).(TransformGroup.Children)[1].(TranslateTransform.Y)" To="0" Duration="__PRESS__"/>
       </Storyboard></BeginStoryboard></Trigger.ExitActions>
      </Trigger>
      <Trigger Property="IsEnabled" Value="False"><Setter TargetName="ButtonFace" Property="Opacity" Value="0.44"/><Setter Property="Cursor" Value="Arrow"/></Trigger>
     </ControlTemplate.Triggers>
    </ControlTemplate>
   </Setter.Value></Setter>
  </Style>
  <Style x:Key="Primary" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
   <Setter Property="Background" Value="{DynamicResource ActionButtonSurface}"/>
   <Setter Property="Foreground" Value="{DynamicResource PlayText}"/>
  </Style>
  <Style x:Key="Play" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
   <Setter Property="Background" Value="{DynamicResource ActionButtonSurface}"/><Setter Property="Foreground" Value="{DynamicResource PlayText}"/>
  </Style>
  <Style x:Key="DangerButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
   <Setter Property="Foreground" Value="{DynamicResource Danger}"/>
  </Style>
  <Style TargetType="TextBox">
   <Setter Property="Foreground" Value="{DynamicResource Text}"/><Setter Property="Background" Value="{DynamicResource ControlSurface}"/>
   <Setter Property="BorderBrush" Value="{DynamicResource ControlBorder}"/><Setter Property="Padding" Value="10,8"/>
   <Setter Property="SelectionBrush" Value="{DynamicResource Accent}"/>
   <Setter Property="SelectionTextBrush" Value="{DynamicResource OnAccent}"/>
   <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRing}"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="TextBox">
    <Border x:Name="EditFace" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="10">
     <ScrollViewer x:Name="PART_ContentHost"/>
    </Border>
    <ControlTemplate.Triggers><Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="EditFace" Property="BorderBrush" Value="{DynamicResource ControlBorder}"/><Setter TargetName="EditFace" Property="BorderThickness" Value="2"/></Trigger></ControlTemplate.Triggers>
   </ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style TargetType="ScrollBar">
   <Setter Property="Width" Value="12"/><Setter Property="MinHeight" Value="12"/>
   <Setter Property="Background" Value="Transparent"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ScrollBar">
    <Track x:Name="PART_Track" Orientation="{TemplateBinding Orientation}" IsDirectionReversed="True">
     <Track.DecreaseRepeatButton><RepeatButton x:Name="Decrease" Command="ScrollBar.PageUpCommand" Focusable="False" Opacity="0"/></Track.DecreaseRepeatButton>
     <Track.Thumb><Thumb MinHeight="20" MinWidth="10"><Thumb.Template><ControlTemplate TargetType="Thumb"><Border Background="{DynamicResource ControlBorder}" CornerRadius="5" Margin="3"/></ControlTemplate></Thumb.Template></Thumb></Track.Thumb>
     <Track.IncreaseRepeatButton><RepeatButton x:Name="Increase" Command="ScrollBar.PageDownCommand" Focusable="False" Opacity="0"/></Track.IncreaseRepeatButton>
    </Track>
    <ControlTemplate.Triggers><Trigger Property="Orientation" Value="Horizontal">
     <Setter TargetName="PART_Track" Property="IsDirectionReversed" Value="False"/>
     <Setter TargetName="Decrease" Property="Command" Value="ScrollBar.PageLeftCommand"/>
     <Setter TargetName="Increase" Property="Command" Value="ScrollBar.PageRightCommand"/>
    </Trigger></ControlTemplate.Triggers>
   </ControlTemplate></Setter.Value></Setter>
   <Style.Triggers><Trigger Property="Orientation" Value="Horizontal"><Setter Property="Width" Value="Auto"/><Setter Property="Height" Value="12"/></Trigger></Style.Triggers>
  </Style>
  <Style TargetType="CheckBox">
   <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRing}"/>
   <Setter Property="Foreground" Value="{DynamicResource Text}"/>
   <Setter Property="Cursor" Value="Hand"/><Setter Property="MinHeight" Value="36"/>
   <Setter Property="VerticalContentAlignment" Value="Center"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="CheckBox">
    <DockPanel LastChildFill="True">
     <Grid Width="36" Height="36" DockPanel.Dock="Left">
      <Border x:Name="CheckSurface" Width="21" Height="21" CornerRadius="6" Background="{DynamicResource ControlSurface}" BorderBrush="{DynamicResource ControlBorder}" BorderThickness="1.5"/>
      <Path x:Name="CheckMark" Data="M 2,8 L 6,12 L 14,3" Width="14" Height="12" Stretch="Fill" Stroke="{DynamicResource PlayText}" StrokeThickness="2.4" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Opacity="0" IsHitTestVisible="False" RenderTransformOrigin="0.5,0.5"><Path.RenderTransform><ScaleTransform/></Path.RenderTransform></Path>
     </Grid>
     <ContentPresenter VerticalAlignment="Center" RecognizesAccessKey="True"/>
    </DockPanel>
    <ControlTemplate.Triggers>
     <Trigger Property="IsChecked" Value="True">
      <Setter TargetName="CheckSurface" Property="Background" Value="{DynamicResource PlaySurface}"/>
      <Setter TargetName="CheckSurface" Property="BorderBrush" Value="{DynamicResource ControlBorder}"/>
      <Trigger.EnterActions><BeginStoryboard><Storyboard>
       <DoubleAnimation Storyboard.TargetName="CheckMark" Storyboard.TargetProperty="Opacity" From="0" To="1" Duration="__TOGGLE__" EasingFunction="{StaticResource EaseOut}"/>
       <DoubleAnimation Storyboard.TargetName="CheckMark" Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)" From="0.72" To="1" Duration="__TOGGLE__" EasingFunction="{StaticResource EaseOut}"/>
       <DoubleAnimation Storyboard.TargetName="CheckMark" Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)" From="0.72" To="1" Duration="__TOGGLE__" EasingFunction="{StaticResource EaseOut}"/>
      </Storyboard></BeginStoryboard></Trigger.EnterActions>
      <Trigger.ExitActions><BeginStoryboard><Storyboard>
       <DoubleAnimation Storyboard.TargetName="CheckMark" Storyboard.TargetProperty="Opacity" To="0" Duration="__TOGGLE__"/>
      </Storyboard></BeginStoryboard></Trigger.ExitActions>
     </Trigger>
     <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="CheckSurface" Property="BorderThickness" Value="3"/></Trigger>
     <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="CheckSurface" Property="BorderBrush" Value="{DynamicResource ControlBorder}"/></Trigger>
     <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.5"/></Trigger>
    </ControlTemplate.Triggers>
   </ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style TargetType="ListBoxItem">
   <Setter Property="Padding" Value="9,10"/><Setter Property="Margin" Value="0,3"/>
   <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
   <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRing}"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListBoxItem">
    <Border x:Name="RowSurface" Background="{DynamicResource RowSurface}" CornerRadius="16" BorderThickness="1" BorderBrush="{DynamicResource Separator}" Padding="{TemplateBinding Padding}">
     <ContentPresenter><ContentPresenter.RenderTransform><TranslateTransform x:Name="RowMotion"/></ContentPresenter.RenderTransform></ContentPresenter>
    </Border>
    <ControlTemplate.Triggers>
     <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="RowSurface" Property="Background" Value="{DynamicResource SoftSurface}"/></Trigger>
     <Trigger Property="IsSelected" Value="True"><Setter TargetName="RowSurface" Property="Background" Value="{DynamicResource SelectedSurface}"/><Setter TargetName="RowSurface" Property="BorderBrush" Value="{DynamicResource SelectionBorder}"/>
      <Trigger.EnterActions><BeginStoryboard><Storyboard><DoubleAnimation Storyboard.TargetName="RowMotion" Storyboard.TargetProperty="X" From="-2" To="0" Duration="__HOVER__" EasingFunction="{StaticResource EaseOut}"/></Storyboard></BeginStoryboard></Trigger.EnterActions>
     </Trigger>
     <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="RowSurface" Property="BorderBrush" Value="{DynamicResource ControlBorder}"/></Trigger>
    </ControlTemplate.Triggers>
   </ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style TargetType="TabItem">
   <Setter Property="Foreground" Value="{DynamicResource SecondaryText}"/><Setter Property="Padding" Value="12,8"/>
   <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRing}"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="TabItem">
    <Border x:Name="TabFace" Background="Transparent" CornerRadius="9" Padding="{TemplateBinding Padding}" Margin="0,0,6,0">
     <ContentPresenter ContentSource="Header" RecognizesAccessKey="True"/>
    </Border>
    <ControlTemplate.Triggers>
     <Trigger Property="IsSelected" Value="True"><Setter TargetName="TabFace" Property="Background" Value="{DynamicResource SelectedSurface}"/><Setter Property="Foreground" Value="{DynamicResource Text}"/><Setter Property="FontWeight" Value="SemiBold"/></Trigger>
     <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="TabFace" Property="Background" Value="{DynamicResource SoftSurface}"/></Trigger>
    </ControlTemplate.Triggers>
   </ControlTemplate></Setter.Value></Setter>
  </Style>

  <Style TargetType="ComboBoxItem"><Setter Property="Foreground" Value="{DynamicResource Text}"/><Setter Property="Background" Value="{DynamicResource ContentSurface}"/><Setter Property="Padding" Value="9,7"/><Style.Triggers><Trigger Property="IsHighlighted" Value="True"><Setter Property="Background" Value="{DynamicResource SelectedSurface}"/></Trigger></Style.Triggers></Style>
  <Style TargetType="ComboBox">
   <Setter Property="Foreground" Value="{DynamicResource Text}"/><Setter Property="MinHeight" Value="37"/><Setter Property="HorizontalContentAlignment" Value="Stretch"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ComboBox"><Grid>
    <ToggleButton Focusable="False" IsChecked="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}" ClickMode="Press"><ToggleButton.Template><ControlTemplate TargetType="ToggleButton"><Border Background="{DynamicResource ControlSurface}" BorderBrush="{DynamicResource ControlBorder}" BorderThickness="1" CornerRadius="9"><TextBlock Text="▾" Foreground="{DynamicResource Text}" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,9,0"/></Border></ControlTemplate></ToggleButton.Template></ToggleButton>
    <ContentPresenter Content="{TemplateBinding SelectionBoxItem}" ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}" Margin="10,5,28,5" VerticalAlignment="Center" IsHitTestVisible="False"/>
    <Popup x:Name="PART_Popup" Placement="Bottom" IsOpen="{TemplateBinding IsDropDownOpen}" AllowsTransparency="True" Focusable="False" PopupAnimation="None"><Border Background="{DynamicResource PopupSurface}" BorderBrush="{DynamicResource ControlBorder}" BorderThickness="1" CornerRadius="8" MinWidth="{Binding ActualWidth,RelativeSource={RelativeSource TemplatedParent}}" MaxWidth="650"><ScrollViewer MaxHeight="260" CanContentScroll="True"><ItemsPresenter/></ScrollViewer></Border></Popup>
   </Grid><ControlTemplate.Triggers><Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.55"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
  </Style>

  <!-- One button template for every action and navigation control. -->
  <Style x:Key="QuietButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
   <Setter Property="Padding" Value="13,8"/>
  </Style>
  <Style x:Key="NavigationButton" TargetType="Button" BasedOn="{StaticResource QuietButton}">
   <Setter Property="Padding" Value="20,9"/>
  </Style>
 </Window.Resources>
 <Grid>
  
  <ScrollViewer x:Name="RootViewport" Margin="{StaticResource PageMargin}" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" Focusable="False">
   <Grid x:Name="Layout" Height="{Binding ActualHeight, ElementName=RootViewport}" Width="{Binding ViewportWidth, ElementName=RootViewport}" MinHeight="720" MinWidth="770">
    <Grid.RowDefinitions><RowDefinition Height="124"/><RowDefinition Height="8"/><RowDefinition Height="78"/><RowDefinition Height="10"/><RowDefinition Height="*" MinHeight="300"/><RowDefinition Height="12"/><RowDefinition Height="72"/></Grid.RowDefinitions>
    <Grid Grid.Row="0">
     <Grid.ColumnDefinitions><ColumnDefinition Width="350"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
     <Image x:Name="BrandLogo" Width="320" Height="124" HorizontalAlignment="Left" Stretch="Uniform" AutomationProperties.Name="OpenSmash Mod Manager" ToolTip="OpenSmash Mod Manager"/>
     <StackPanel Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Center">
      <StackPanel x:Name="HeaderTools" Orientation="Horizontal" HorizontalAlignment="Right">
       <Button x:Name="RetryButton" Content="Erneut versuchen" Visibility="Collapsed" Margin="0,0,8,0"/>
       <Button x:Name="AppearanceButton" Content="Design" Style="{StaticResource QuietButton}" Margin="0,0,8,0" ToolTip="Hell, Dunkel oder Windows-Einstellung"/>
       <Button x:Name="MoreButton" Content="Mehr ⋯" Style="{StaticResource QuietButton}" AutomationProperties.Name="Weitere Funktionen">
        <Button.ContextMenu><ContextMenu x:Name="MoreMenu" Style="{StaticResource AppearanceMenu}" Background="{DynamicResource PopupSurface}" Foreground="{DynamicResource Text}">
         <MenuItem x:Name="ExportButton" Header="Alle Mods als ZIP exportieren…" Style="{StaticResource AppearanceItem}"/>
         <MenuItem x:Name="ExportListButton" Header="Modliste teilen…" Style="{StaticResource AppearanceItem}"/>
         <MenuItem x:Name="ImportListButton" Header="Modliste importieren…" Style="{StaticResource AppearanceItem}"/>
         <MenuItem x:Name="BulkButton" Header="Sichtbare Mods umschalten" Style="{StaticResource AppearanceItem}"/>
         <Separator/>
         <MenuItem x:Name="OpenLinkButton" Header="GameBanana-Link öffnen…" Style="{StaticResource AppearanceItem}"/>
         <MenuItem x:Name="CopyLinkButton" Header="Manager-Link zur Datei kopieren" IsEnabled="False" Style="{StaticResource AppearanceItem}"/>
         <MenuItem x:Name="CoverButton" Header="Titelbild auswählen…" Style="{StaticResource AppearanceItem}"/>
         <MenuItem x:Name="UpdatesButton" Header="GameBanana-Updates prüfen" Style="{StaticResource AppearanceItem}"/>
         <MenuItem x:Name="RefreshButton" Header="Bibliothek vollständig prüfen" InputGestureText="Strg+R" Style="{StaticResource AppearanceItem}"/>
         <MenuItem x:Name="LogsButton" Header="Protokolle öffnen" InputGestureText="Strg+L" Style="{StaticResource AppearanceItem}"/>
         <Separator/>
         <MenuItem Header="Version 3.7.0" IsEnabled="False" Style="{StaticResource AppearanceItem}"/>
        </ContextMenu></Button.ContextMenu>
       </Button>
      </StackPanel>
      <TextBlock x:Name="ProjectPath" Visibility="Collapsed" Background="Transparent" Margin="0,10,4,0" MaxWidth="430" FontSize="{DynamicResource MetaSize}" Foreground="{DynamicResource SecondaryText}" TextTrimming="CharacterEllipsis" HorizontalAlignment="Right" AutomationProperties.Name="Verbundenes OpenSmash-Spiel"/>
     </StackPanel>
    </Grid>
    <Border x:Name="DropSurface" Grid.Row="2" CornerRadius="{StaticResource PanelRadius}" Background="{DynamicResource ImportSurface}" BorderBrush="{DynamicResource PanelBorder}" BorderThickness="1" AllowDrop="True" Padding="16,10" AutomationProperties.Name="Mod-ZIP, RAR, 7z oder Mod-Ordner ablegen">
     <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
      <Border x:Name="DropHalo" Grid.ColumnSpan="2" Margin="-16,-10" BorderBrush="{DynamicResource Accent}" BorderThickness="2" CornerRadius="{StaticResource PanelRadius}" Opacity="0" IsHitTestVisible="False"/>
      <StackPanel VerticalAlignment="Center" Margin="0,0,12,0"><TextBlock x:Name="DropTitle" Text="Mods hinzufügen" FontSize="17" FontWeight="SemiBold"/>
       <TextBlock x:Name="DropHint" Text="ZIP/RAR/7z oder Ordner hier ablegen" Foreground="{DynamicResource SecondaryText}" FontSize="{DynamicResource MetaSize}" Margin="0,3,0,0"/>
      </StackPanel>
      <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
       <Button x:Name="ZipButton" Content="Dateien…" Style="{StaticResource QuietButton}" Margin="0,0,7,0" ToolTip="Eine oder mehrere ZIP-/RAR-/7z-Dateien prüfen (Strg+O)"/>
       <Button x:Name="FolderButton" Content="Ordner…" Style="{StaticResource QuietButton}" ToolTip="Entpackten Mod-Ordner prüfen (Strg+Umschalt+O)"/>
       <TextBlock x:Name="PreviewSummary" Text="" Visibility="Collapsed" VerticalAlignment="Center" FontSize="{DynamicResource MetaSize}" Margin="10,0,0,0"/>
       <Button x:Name="InstallButton" Content="Installieren" Style="{StaticResource Primary}" Margin="10,0,0,0" IsEnabled="False" Visibility="Collapsed" ToolTip="Geprüfte Auswahl installieren (Strg+I)"/>
      </StackPanel>
     </Grid>
    </Border>
    <Grid Grid.Row="4">
     <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
     <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
      <Button x:Name="LibraryNav" Content="Bibliothek" Style="{StaticResource NavigationButton}" Margin="0,0,6,0"/>
      <Button x:Name="DiscoverNav" Content="Entdecken" Style="{StaticResource NavigationButton}" Margin="0,0,6,0"/>
      <Button x:Name="DownloadsNav" Content="Downloads" Style="{StaticResource NavigationButton}"/>
     </StackPanel>
     <Grid x:Name="LibraryWorkspace" Grid.Row="1">
     <Grid.ColumnDefinitions><ColumnDefinition Width="1.65*"/><ColumnDefinition Width="14"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
     <Border x:Name="LibraryPanel" CornerRadius="{StaticResource PanelRadius}" Background="{DynamicResource ContentSurface}" BorderBrush="{DynamicResource PanelBorder}" BorderThickness="1" Padding="{StaticResource PanelPadding}">
      <Grid>
       <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
       <DockPanel Margin="0,0,0,10"><TextBlock Text="Bibliothek" FontSize="{DynamicResource SectionSize}" FontWeight="SemiBold" DockPanel.Dock="Left"/>
        <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" Margin="8,0,0,0"><Button x:Name="ListViewButton" Content="Liste" Padding="10,6" Margin="0,0,5,0" ToolTip="Listenansicht"/><Button x:Name="TileViewButton" Content="Kacheln" Padding="10,6" ToolTip="Kachelansicht"/></StackPanel>
        <TextBlock x:Name="ModCount" Text="Noch keine Mods" HorizontalAlignment="Right" VerticalAlignment="Center" FontSize="{DynamicResource MetaSize}" Foreground="{DynamicResource SecondaryText}"/>
       </DockPanel>
       <Grid Grid.Row="1" Margin="0,0,0,9" MinHeight="37"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
        <TextBox x:Name="SearchBox" AutomationProperties.Name="Mods durchsuchen" ToolTip="Nach Mod-Namen suchen (Strg+F)"/>
        <TextBlock Text="Mods durchsuchen" Margin="11,8,0,0" Foreground="{DynamicResource SecondaryText}" IsHitTestVisible="False"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding Text,ElementName=SearchBox}" Value=""><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock>
       </Grid>
       <Grid Grid.Row="2">
        <ListBox x:Name="ModsList" Foreground="{DynamicResource Text}" BorderThickness="0" Background="Transparent" ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.VerticalScrollBarVisibility="Auto" ScrollViewer.CanContentScroll="True" VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling" AutomationProperties.Name="Installierte Mods" Padding="0,0,5,0">
        </ListBox>
        <TextBlock x:Name="EmptyLibrary" Text="Deine Bibliothek ist noch leer.&#10;Füge oben deine erste Mod hinzu." Foreground="{DynamicResource SecondaryText}" TextWrapping="Wrap" HorizontalAlignment="Center" VerticalAlignment="Center" TextAlignment="Center" Margin="16" IsHitTestVisible="False"/>
       </Grid>
       <WrapPanel Grid.Row="3" Margin="0,10,0,0">
        <Button x:Name="RemoveButton" Content="Mod entfernen" Style="{StaticResource DangerButton}" IsEnabled="False" Margin="0,0,8,0" ToolTip="Ausgewählte Mod aus der Auswahl entfernen; Rückgängig bleibt möglich"/>
        <Button x:Name="UndoButton" Content="Rückgängig" IsEnabled="False" ToolTip="Vorherige Mod-Auswahl wiederherstellen (Strg+Z)"/>
       </WrapPanel>
      </Grid>
     </Border>
     <Border x:Name="DetailsPanel" Grid.Column="2" CornerRadius="{StaticResource PanelRadius}" Background="{DynamicResource ContentSurface}" BorderBrush="{DynamicResource PanelBorder}" BorderThickness="1" Padding="{StaticResource PanelPadding}">
      <Grid>
       <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
       <DockPanel Margin="0,0,0,12"><TextBlock Text="Details" FontSize="{DynamicResource SectionSize}" FontWeight="SemiBold"/>
        <Border x:Name="DetailBadge" Background="{DynamicResource InfoSurface}" CornerRadius="8" Padding="8,3" HorizontalAlignment="Right" Margin="10,0,0,0"><TextBlock x:Name="DetailBadgeText" Text="Info" FontSize="{DynamicResource MetaSize}"/></Border>
       </DockPanel>
       <TabControl x:Name="DetailTabs" Grid.Row="1" Background="Transparent" BorderThickness="0" Padding="0,14,0,0">
        <TabItem Header="_Details"><Grid x:Name="DetailContent">
         <Grid.RenderTransform><TranslateTransform/></Grid.RenderTransform>
         <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
         <TextBlock x:Name="DetailTitle" Text="Mod auswählen" FontSize="{DynamicResource DetailSize}" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,0,0,7"/>
         <TextBlock x:Name="DetailSubtitle" Grid.Row="1" Text="" Foreground="{DynamicResource SecondaryText}" TextWrapping="Wrap" Margin="0,0,0,12"/>
         <TextBox x:Name="DetailsText" Grid.Row="2" IsReadOnly="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" BorderThickness="0" Background="Transparent" Padding="0,0,4,0" Text="" AutomationProperties.Name="Prüfergebnis und Hinweise"/>
        </Grid></TabItem>
        <TabItem Header="_Aktivität"><TextBox x:Name="ActivityText" IsReadOnly="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" BorderThickness="0" Background="Transparent" Padding="0,0,4,0" FontFamily="Consolas" FontSize="{DynamicResource MetaSize}" AutomationProperties.Name="Aktivitätsprotokoll"/></TabItem>
        <TabItem x:Name="BatchTab" Header="_Importliste" Visibility="Collapsed">
         <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
          <TextBlock x:Name="BatchSummary" Text="Mod-Auswahl pruefen" TextWrapping="Wrap" FontWeight="SemiBold" Margin="0,0,0,9"/>
          <ProgressBar Style="{StaticResource ItemProgress}" x:Name="BatchProgress" Grid.Row="1" Height="5" Minimum="0" Maximum="1" Foreground="{DynamicResource Accent}" Background="{DynamicResource SoftSurface}" Margin="0,0,0,10" AutomationProperties.Name="Stapel-Fortschritt nach Mods"/>
          <ListBox x:Name="BatchList" Grid.Row="2" Foreground="{DynamicResource Text}" Background="Transparent" BorderThickness="0" ScrollViewer.HorizontalScrollBarVisibility="Disabled" VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling" AutomationProperties.Name="Gepruefte Mods und Importergebnisse">
           <ListBox.ItemTemplate><DataTemplate><StackPanel>
            <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextWrapping="Wrap"/>
            <TextBlock Text="{Binding Status}" Foreground="{DynamicResource SecondaryText}" Margin="0,3,0,0"/>
            <TextBlock Text="{Binding Message}" Foreground="{DynamicResource SecondaryText}" TextWrapping="Wrap" FontSize="{DynamicResource MetaSize}" Margin="0,3,0,0"/>
           </StackPanel></DataTemplate></ListBox.ItemTemplate>
          </ListBox>
          <StackPanel Grid.Row="3" Margin="0,9,0,0"><WrapPanel x:Name="ConflictActions" Visibility="Collapsed" Margin="0,0,0,6"><Button x:Name="ConflictDisabled" Content="Pausiert installieren" Margin="0,0,6,0"/><Button x:Name="ConflictReplace" Content="Konfliktpartner ersetzen" Margin="0,0,6,0"/><Button x:Name="ConflictOverlay" Content="Als Skin/Patch ueberlagern" Margin="0,0,6,0"/><Button x:Name="ConflictUnderlay" Content="Als Basis ergaenzen"/></WrapPanel>
          <DockPanel><Button x:Name="BatchCancel" Content="Abbrechen" IsEnabled="False" DockPanel.Dock="Right" Margin="10,0,0,0"/>
           
          </DockPanel></StackPanel>
         </Grid>
        </TabItem>
       </TabControl>
      </Grid>
     </Border>
    </Grid>
     <ContentControl x:Name="DiscoverWorkspace" Grid.Row="1" Visibility="Collapsed" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch"/>
     <ContentControl x:Name="DownloadsWorkspace" Grid.Row="1" Visibility="Collapsed" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch"/>
    </Grid>
    <Border x:Name="ActionSurface" Grid.Row="6" Background="{DynamicResource GlassSurface}" BorderBrush="{DynamicResource GlassEdge}" BorderThickness="1" CornerRadius="{StaticResource PanelRadius}" Padding="16,12">
     <Grid>
      <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
      <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
      <StackPanel VerticalAlignment="Center" Margin="0,0,16,0">
       <DockPanel><TextBlock x:Name="StatusSymbol" Text="●" FontSize="12" Foreground="{DynamicResource Success}" Margin="0,2,8,0" DockPanel.Dock="Left"/>
        <TextBlock x:Name="StatusText" Text="Modmanager wird vorbereitet…" TextWrapping="Wrap"/>
       </DockPanel>
       <ProgressBar x:Name="BusyProgress" Height="3" Margin="20,7,20,0" IsIndeterminate="False" Visibility="Hidden" Foreground="{DynamicResource Accent}" Background="{DynamicResource SoftSurface}" AutomationProperties.Name="Vorgang läuft"/>
      </StackPanel>
      <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center"><Button x:Name="OperationCancel" Content="Abbrechen" Visibility="Collapsed" Margin="0,0,8,0"/>
       <Button x:Name="PlayButton" Style="{StaticResource Play}" ToolTip="Mit aktiven Mods starten (F5)" Margin="0,0,8,0"><StackPanel Orientation="Horizontal"><Path Data="M 0,0 L 0,12 L 10,6 Z" Fill="{DynamicResource PlayText}" Width="10" Height="12" Stretch="Uniform" Margin="0,0,10,0"/><AccessText Text="Mit Mods _spielen"/></StackPanel></Button>
       <Button x:Name="VanillaButton" Content="_Vanilla spielen" ToolTip="Ohne verwaltete Mods starten (F6)"/>
      </StackPanel>
     </Grid>
    </Border>
   </Grid>
  </ScrollViewer>
 </Grid>
</Window>
