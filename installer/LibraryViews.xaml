<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
 <ItemsPanelTemplate x:Key="LibraryListPanel"><VirtualizingStackPanel/></ItemsPanelTemplate>
 <ItemsPanelTemplate x:Key="LibraryTilePanel"><WrapPanel/></ItemsPanelTemplate>
 <DataTemplate x:Key="LibraryListView">
  <Grid MinHeight="66">
   <Grid.ColumnDefinitions><ColumnDefinition Width="36"/><ColumnDefinition Width="88"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
   <CheckBox IsChecked="{Binding Active,Mode=OneWay}" IsEnabled="{DynamicResource CanChangeMods}" Tag="{Binding Id}" AutomationProperties.Name="{Binding Name}" AutomationProperties.HelpText="Mod aktivieren oder pausieren" VerticalAlignment="Center"/>
   <Border Grid.Column="1" Background="{DynamicResource SoftSurface}" CornerRadius="8" Margin="4,0,8,0" ClipToBounds="True">
    <Grid><TextBlock Text="MOD" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{DynamicResource SecondaryText}"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding Thumbnail}" Value="{x:Null}"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock>
     <Image Source="{Binding Thumbnail}" Height="56" Stretch="UniformToFill"/></Grid>
   </Border>
   <StackPanel Grid.Column="2" VerticalAlignment="Center" Margin="4,0,0,0">
    <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextWrapping="Wrap"/>
    <TextBlock Text="{Binding StatusText}" Foreground="{DynamicResource SecondaryText}" FontSize="{DynamicResource MetaSize}" Margin="0,5,0,0"/>
   </StackPanel>
  </Grid>
 </DataTemplate>
 <DataTemplate x:Key="LibraryTileView">
  <Grid ToolTip="{Binding Name}">
   <Grid.RowDefinitions><RowDefinition Height="88"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
   <Border Background="{DynamicResource SoftSurface}" CornerRadius="9" ClipToBounds="True">
    <Grid><TextBlock Text="MOD" FontSize="22" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{DynamicResource SecondaryText}"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding Thumbnail}" Value="{x:Null}"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock>
     <Image Source="{Binding Thumbnail}" Height="88" Stretch="UniformToFill"/></Grid>
   </Border>
   <TextBlock Grid.Row="1" Text="{Binding Name}" FontWeight="SemiBold" TextWrapping="Wrap" TextTrimming="CharacterEllipsis" MinHeight="36" MaxHeight="36" Margin="0,5,0,3"/>
   <CheckBox Grid.Row="2" Content="{Binding StatusText}" IsChecked="{Binding Active,Mode=OneWay}" IsEnabled="{DynamicResource CanChangeMods}" Tag="{Binding Id}" AutomationProperties.Name="{Binding Name}" AutomationProperties.HelpText="Mod aktivieren oder pausieren"/>
  </Grid>
 </DataTemplate>
</ResourceDictionary>
