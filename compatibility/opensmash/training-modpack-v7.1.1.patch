+/* A persistent, anonymous ID for this local user-data directory. Never expose
+ * the PC's hardware identifiers to a guest plugin. Uuid is exactly 16 bytes. */
+static void oe_GetPseudoDeviceId(Ctx *c) {
+    const char *fs_user_root(void);
+    char path[MAX_PATH];
+    uint8_t id[16] = {0};
+    DWORD count = 0;
+    HANDLE file = INVALID_HANDLE_VALUE;
+    int length = snprintf(path, sizeof path, "%s\\pseudo-device-id.bin", fs_user_root());
+    if (length < 0 || length >= (int)sizeof path) { guest_trap("local pseudo-device ID path is too long", c->x[30]); return; }
+    for (int retry = 0; retry < 100; retry++) {
+        file = CreateFileA(path, GENERIC_READ | GENERIC_WRITE, 0, NULL, OPEN_ALWAYS, FILE_ATTRIBUTE_NORMAL, NULL);
+        if (file != INVALID_HANDLE_VALUE || GetLastError() != ERROR_SHARING_VIOLATION) break;
+        Sleep(1);
+    }
+    if (file == INVALID_HANDLE_VALUE) { guest_trap("cannot open local pseudo-device ID", c->x[30]); return; }
+    LARGE_INTEGER size;
+    int ok = GetFileSizeEx(file, &size) != 0;
+    if (ok && size.QuadPart == 0) {
+        HCRYPTPROV prov = crypt_provider();
+        ok = prov && CryptGenRandom(prov, sizeof id, id);
+        id[6] = (uint8_t)((id[6] & 15) | 0x40); id[8] = (uint8_t)((id[8] & 63) | 0x80);
+        ok = ok && WriteFile(file, id, sizeof id, &count, NULL) && count == sizeof id && FlushFileBuffers(file);
+    } else if (ok && size.QuadPart == sizeof id) {
+        ok = ReadFile(file, id, sizeof id, &count, NULL) && count == sizeof id;
+    } else ok = 0;
+    CloseHandle(file);
+    if (!ok) { guest_trap("invalid or unreadable local pseudo-device ID", c->x[30]); return; }
+    memcpy((void *)(uintptr_t)A0, id, sizeof id);
+    RET(0);
+}
