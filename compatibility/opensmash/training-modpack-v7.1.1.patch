     def simd(self, w, pc):
         rd, rn, rm = bits(w, 4, 0), bits(w, 9, 5), bits(w, 20, 16)
+        # Integer vector forms emitted by Rust/LLVM (all operands captured before writes).
+        q, size = bits(w, 30, 30), bits(w, 23, 22)
+        if (w & 0xbffffc00) == 0x0e201800:           # REV16 .8b / .16b
+            return '{ V128 a = c->v[%d], t = {{0}}; %s c->v[%d] = t; }' % (rn,
+                ' '.join('t.b[%d] = a.b[%d];' % (i, i ^ 1) for i in range(16 if q else 8)), rd)
+        wide = {0x2e201000: 'addw', 0x2e208000: 'mlal', 0x2e20c000: 'mull'}.get(w & 0xbf20fc00)
+        if wide and size < 3:                       # UADDW(2), UMLAL(2), UMULL(2)
+            narrow, dest = ('b', 'h', 'w')[size], ('h', 'w', 'd')[size]
+            lanes = 8 >> size
+            offset = lanes if q else 0
+            body = []
+            for i in range(lanes):
+                left = 'a.%s[%d]' % (dest if wide == 'addw' else narrow, i if wide == 'addw' else i + offset)
+                right = 'b.%s[%d]' % (narrow, i + offset)
+                expr = '(uint64_t)%s %s (uint64_t)%s' % (left, '+' if wide == 'addw' else '*', right)
+                if wide == 'mlal': expr = 'old.%s[%d] + (%s)' % (dest, i, expr)
+                body.append('t.%s[%d] = %s;' % (dest, i, expr))
+            return '{ V128 a = c->v[%d], b = c->v[%d], old = c->v[%d], t = {{0}}; %s c->v[%d] = t; }' % (rn, rm, rd, ' '.join(body), rd)
+        mul = w & 0xbf20fc00
+        if mul in (0x0e209400, 0x2e209400) and size < 3:  # MLA / MLS (vector)
+            member = ('b', 'h', 'w')[size]
+            body = ' '.join('t.%s[%d] = old.%s[%d] %s (uint64_t)a.%s[%d] * b.%s[%d];' %
+                (member, i, member, i, '-' if mul == 0x2e209400 else '+', member, i, member, i)
+                for i in range((16 if q else 8) >> size))
+            return '{ V128 a = c->v[%d], b = c->v[%d], old = c->v[%d], t = {{0}}; %s c->v[%d] = t; }' % (rn, rm, rd, body, rd)
+        if (w & 0x9f000400) == 0x0f000000 and size in (1, 2):
+            opcode, u = bits(w, 15, 12), bits(w, 29, 29)
+            if (opcode, u) in ((0, 1), (12, 0)):     # MLA / SQDMULH (by element)
+                width, member = (16, 'h') if size == 1 else (32, 'w')
+                index = (bits(w, 11, 11) << (2 if size == 1 else 1)) | (bits(w, 21, 21) << (1 if size == 1 else 0))
+                reg = bits(w, 19, 16) if size == 1 else rm
+                if size == 1: index |= bits(w, 20, 20)
+                body = []
+                for i in range((128 if q else 64) // width):
+                    if opcode == 0:
+                        body.append('t.%s[%d] = old.%s[%d] + (uint64_t)a.%s[%d] * b.%s[%d];' % (member,i,member,i,member,i,member,index))
+                    else:
+                        maximum = (1 << (width-1)) - 1
+                        body.append('{ int64_t p = (int64_t)(int%d_t)a.%s[%d] * (int64_t)(int%d_t)b.%s[%d]; int64_t r = p >> %d; if (r > %d) r = %d; t.%s[%d] = r; }' %
+                            (width,member,i,width,member,index,width-1,maximum,maximum,member,i))
+                return '{ V128 a = c->v[%d], b = c->v[%d], old = c->v[%d], t = {{0}}; %s c->v[%d] = t; }' % (rn,reg,rd,' '.join(body),rd)
         if (w & 0x9ff80c00) == 0x0f000400:               # movi / mvni / orr-imm (modified immediate)
             q, op, cmode = bits(w, 30, 30), bits(w, 29, 29), bits(w, 15, 12)
             imm8 = (bits(w, 18, 16) << 5) | bits(w, 9, 5)
@@ -676,6 +717,14 @@
                 if double:
                     return struct.unpack('<Q', struct.pack('<d', value))[0]
