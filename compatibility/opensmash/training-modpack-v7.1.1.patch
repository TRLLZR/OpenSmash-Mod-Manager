diff --git a/tests/simd_immediate_test.py b/tests/simd_immediate_test.py
new file mode 100644
--- /dev/null
+++ b/tests/simd_immediate_test.py
@@ -0,0 +1,66 @@
+"""Compare generated ORR/BIC immediate code against Unicorn; no game data.
+
+Run with --clang <clang executable>. Requires unicorn in the test Python.
+Both lifter copies are extracted by AST so no dumped ELF is imported.
+"""
+import argparse, ast, ctypes, random, struct, subprocess, tempfile
+import _ctypes
+from pathlib import Path
+from unicorn import Uc, UC_ARCH_ARM64, UC_MODE_ARM
+from unicorn.arm64_const import UC_ARM64_REG_Q0
+
+def translator(path):
+    tree = ast.parse(path.read_text())
+    cls = next(n for n in tree.body if isinstance(n, ast.ClassDef) and n.name == 'Fn')
+    method = next(n for n in cls.body if isinstance(n, ast.FunctionDef) and n.name == 'simd')
+    method.decorator_list = []
+    ns = dict(struct=struct, bits=lambda w, hi, lo: (w >> lo) & ((1 << (hi - lo + 1)) - 1))
+    exec(compile(ast.fix_missing_locations(ast.Module(body=[method], type_ignores=[])), str(path), 'exec'), ns)
+    return lambda word: ns['simd'](None, word, 0)
+
+def main():
+    p = argparse.ArgumentParser()
+    p.add_argument('--clang', required=True)
+    a = p.parse_args()
+    root = Path(__file__).resolve().parents[1]
+    lifters = [translator(root / f) for f in ('tools/lifter/recomp.py', 'tools/nro/recomp_nro.py')]
+    words = [0x0f000400 | (q << 30) | (op << 29) | (mode << 12) | ((imm >> 5) << 16) | ((imm & 31) << 5)
+             for q in range(2) for op in range(2) for mode in (1,3,5,7,9,11) for imm in (0,1,0x55,0x80,0xff)]
+    words += [0x4e201800, 0x0f80c022, 0x2fa00041, 0x4f80c822, 0x6fa00841, 0x4f40c022, 0x6f500041]
+    words += [base | (q << 30) | (size << 22) | (rm << 16) | (rn << 5) | rd
+        for base in (0x2e201000, 0x2e208000, 0x2e20c000, 0x0e209400, 0x2e209400)
+        for q in range(2) for size in range(3) for rd,rn,rm in ((0,0,1),(2,1,2),(3,4,5))]
+    cases = []
+    for i, word in enumerate(words):
+        code = lifters[0](word)
+        assert code == lifters[1](word), 'main and NRO lifters differ'
+        cases.append(f'case {i}: {code} break;')
+    src = '#include <stdint.h>\ntypedef union {uint8_t b[16]; uint16_t h[8]; uint32_t w[4]; uint64_t d[2];} V128; typedef struct {V128 v[32];} Ctx;\n'
+    src += '__declspec(dllexport) void run(int i, Ctx *c) {switch(i){' + '\n'.join(cases) + '}}'
+    rng = random.Random(1984)
+    with tempfile.TemporaryDirectory() as tmp:
+        cfile, dll = Path(tmp) / 'test.c', Path(tmp) / 'test.dll'
+        cfile.write_text(src)
+        subprocess.run([a.clang, '-shared', '-O2', str(cfile), '-o', str(dll)], check=True)
+        lib = ctypes.CDLL(str(dll))
+        lib.run.argtypes = [ctypes.c_int, ctypes.c_void_p]
+        cpu = Uc(UC_ARCH_ARM64, UC_MODE_ARM)
+        cpu.mem_map(0x10000, 4096)
+        for i, word in enumerate(words):
+            for sample in range(4):
+                buf = (ctypes.c_uint64 * 64)()
+                for reg in range(32):
+                    initial = rng.getrandbits(128) if sample < 2 else int.from_bytes((b'\x00\x80' if sample == 2 else b'\x00\x00\x00\x80') * (8 if sample == 2 else 4), 'little')
+                    buf[2*reg], buf[2*reg+1] = initial & ((1 << 64)-1), initial >> 64
+                    cpu.reg_write(UC_ARM64_REG_Q0 + reg, initial)
+                lib.run(i, buf)
+                cpu.mem_write(0x10000, word.to_bytes(4, 'little'))
+                cpu.ctl_remove_cache(0x10000, 0x10004)
+                cpu.emu_start(0x10000, 0x10004, count=1)
+                for reg in range(32):
+                    expected = cpu.reg_read(UC_ARM64_REG_Q0 + reg)
+                    assert buf[2*reg] | (buf[2*reg+1] << 64) == expected, (hex(word), sample, reg)
+        _ctypes.FreeLibrary(lib._handle)
+    print(f'{len(words)*4} integer SIMD differential cases passed (both lifters, all registers).')
+
+if __name__ == '__main__': main()
